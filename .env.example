# ============================================================
# FATE WebApp UI - Environment Example
#
# Copy this file to ".env" and fill in your own values.
# Do NOT commit the real ".env" file to GitHub.
# ============================================================


# ------------------------------------------------------------
# FastAPI App
# ------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8000


# ------------------------------------------------------------
# Docker Oracle Database
# ------------------------------------------------------------
# ORACLE_PWD is used by the Oracle Docker container to initialize
# SYS / SYSTEM / PDBADMIN passwords.
#
# This is only for the local Docker database.
# Do not use this as a production database password.
ORACLE_PWD=OracleSysPassword123


# ------------------------------------------------------------
# WebApp Database Connection
# ------------------------------------------------------------
# The database user FATE_APP is created by:
# docker/oracle/init/01_create_app_user.sql
#
# If the WebApp runs directly on your host machine, use 127.0.0.1.
DATABASE_URL=oracle+oracledb://FATE_APP:fate_app_password@127.0.0.1:1521/?service_name=XEPDB1

# If the WebApp is also containerized later, use this instead:
# DATABASE_URL=oracle+oracledb://FATE_APP:fate_app_password@oracle-db:1521/?service_name=XEPDB1


# ------------------------------------------------------------
# WebApp Authentication
# ------------------------------------------------------------
# Generate APP_SECRET_KEY:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=replace_with_random_secret_key

# Generate APP_FERNET_KEY:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Important:
# APP_FERNET_KEY is used to encrypt and decrypt remote server passwords.
# If this key changes, old encrypted server passwords in the database
# cannot be decrypted.
APP_FERNET_KEY=replace_with_fernet_key

ACCESS_TOKEN_EXPIRE_MINUTES=720


# ------------------------------------------------------------
# Default Administrator Account for Testing
# ------------------------------------------------------------
# The seed script will create this WebApp account:
#
# Account: administrator
# Password: 123456
#
# The WebApp password will be stored as a hash.
ADMIN_ACCOUNT=administrator
ADMIN_PASSWORD=123456

# These values are used as the remote FATE server credentials
# for the administrator account.
#
# They are encrypted by scripts/seed_admin.py before being stored
# in the Oracle database.
#
# Do NOT commit real values to GitHub.
ADMIN_SERVER_USERNAME=your_fate_server_username
ADMIN_SERVER_PASSWORD=your_fate_server_password


# ------------------------------------------------------------
# Remote FATE Server SSH Configuration
# ------------------------------------------------------------
GRACE_HOST=your_remote_fate_server_host
GRACE_PORT=22

# ------------------------------------------------------------
# FATE Docker / Runtime Configuration
# ------------------------------------------------------------
FATE_CONTAINER=standalone_fate
FATE_ROOT=/data/projects/fate


# ------------------------------------------------------------
# Optional FATE Flow SDK Configuration
# ------------------------------------------------------------
FATE_HOST=127.0.0.1
FATE_PORT=9380
FATE_API_VERSION=v1